<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>DB Deployment - @ViewBag.Title</title>
	@Styles.Render("~/styles/vendor")
	@Styles.Render("~/less/site")
	@RenderSection("styles", required: false)
</head>
<body>
	<nav class="navbar navbar-default navbar-static" role="navigation">
		<div class="container-fluid">
			<div class="navbar-header">
				<span class="navbar-brand">DB Deployment</span>
			</div>
			<div class="collapse navbar-collapse" id="topmenu">
				<ul class="nav navbar-nav" id="menubar">
					<li id="release-menu"><a href="@Url.Action("Index", "DeployLog")"><span class="release-none"></span>
						Deloyment Log</a> </li>
					<li id="dashboard-menu"><a href="@Url.Action("CreatePackage", "Package")"><span class="dashboard-none">
					</span>Deploy Package</a> </li>
					<li id="setting-menu"><a href="@Url.Action("Index", "Setting")"><span class="setting-none"></span>
						System Setting</a> </li>
				</ul>
				<div class="navbar-right user-name">
					@User.Identity.Name
				</div>
			</div>
		</div>
	</nav>
	@RenderBody()
	<div id="popupmodal" class="modal fade">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header modal-header-title">
					<button type="button" class="close" data-dismiss="modal" aria-hidden="true">
						&times;</button>
					<h4 class="modal-title title" id="modeltitle">
						Modal title</h4>
				</div>
				<div class="modal-body clearfix" id="modalContent">
				</div>
			</div>
		</div>
	</div>
	<div id='loading_status' class="hide">
		<img alt="" src="~/Content/images/loading.gif" />
	</div>
	@Scripts.Render("~/scripts/vendor")
	@RenderSection("scripts", required: false)
</body>
</html>
